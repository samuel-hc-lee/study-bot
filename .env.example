# Required: from @BotFather on Telegram. Never commit or share this.
TELEGRAM_BOT_TOKEN=

# Optional: lock the bot to your chat. If blank, whoever sends /start first owns it.
ALLOWED_CHAT_ID=

TIMEZONE=Australia/Sydney
DAY_START=09:00
DAY_END=22:00

# Random gap between check-ins (minutes)
MIN_GAP_MINUTES=30
MAX_GAP_MINUTES=75

# Re-ping if you don't answer within this many minutes
NUDGE_AFTER_MINUTES=10

# After "Break" or "Distracted", check again this soon
FOLLOWUP_MINUTES=15
